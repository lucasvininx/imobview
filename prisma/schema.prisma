generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions Session[]
  accounts Account[]
  memberships OrganizationMember[]
}

model Session {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  token String @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope String?
  password String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  identifier String
  value String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([identifier])
}

model RateLimit {
  id String @id @default(dbgenerated("(gen_random_uuid())::text"))
  key String @unique
  count Int
  lastRequest BigInt
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  contactEmail String @default("") @db.VarChar(254)
  whatsapp String @default("") @db.VarChar(15)
  maxProperties Int @default(30)
  maxStorageBytes BigInt @default(2147483648)
  maxPanoramas Int @default(300)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  members OrganizationMember[]
  properties Property[]
  tours Tour[]
  brokers Broker[]
}

model OrganizationMember {
  organizationId String @db.Uuid
  userId String
  role Role @default(MEMBER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
  @@index([userId])
}

enum PropertyStatus {
  DRAFT
  PROCESSING
  READY
  PUBLISHED
  ARCHIVED
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
}

enum Purpose {
  SALE
  RENT
}

model Property {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  slug String @unique
  description String @default("") @db.VarChar(5000)
  type PropertyType @default(APARTMENT)
  purpose Purpose @default(SALE)
  neighborhood String @default("") @db.VarChar(120)
  city String @default("") @db.VarChar(120)
  state String @default("") @db.VarChar(2)
  priceCents BigInt @default(0)
  area Int @default(0)
  bedrooms Int @default(0)
  bathrooms Int @default(0)
  parkingSpaces Int @default(0)
  status PropertyStatus @default(DRAFT)
  cover String?
  internalCode String @default("") @db.VarChar(80)
  address String @default("") @db.VarChar(240)
  condominium String @default("") @db.VarChar(160)
  suites Int @default(0)
  commercialNotes String @default("") @db.VarChar(2000)
  captureLeads Boolean @default(false)
  brokerId String? @db.Uuid
  broker Broker? @relation(fields: [brokerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  leads Lead[]
  visits TourVisit[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  publishedAt DateTime? @db.Timestamptz(3)
  archivedAt DateTime? @db.Timestamptz(3)
  tours Tour[]
  photos PropertyPhoto[]
  @@index([organizationId, status, createdAt])
  @@unique([id, organizationId])
}

model Broker {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String @db.VarChar(120)
  email String @db.VarChar(254)
  phone String @db.VarChar(15)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  properties Property[]
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model Lead {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId String @db.Uuid
  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name String @db.VarChar(160)
  email String @db.VarChar(254)
  phone String @db.VarChar(15)
  stage String @default("NEW") @db.VarChar(30)
  notes String @default("") @db.VarChar(5000)
  source String @default("direct") @db.VarChar(120)
  consentAt DateTime @default(now()) @db.Timestamptz(3)
  consentVersion String @default("journey-v1")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  proposalAt DateTime? @db.Timestamptz(3)
  wonAt DateTime? @db.Timestamptz(3)
  visits TourVisit[]
  requests VisitRequest[]
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, propertyId, stage])
}

model TourVisit {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId String @db.Uuid
  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tourId String @db.Uuid
  leadId String? @db.Uuid
  lead Lead? @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tokenHash String @unique @db.VarChar(64)
  abuseKey String @db.VarChar(64)
  source String @db.VarChar(120)
  tracking Boolean
  scenes Json
  lastSequence Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  events JourneyEvent[]
  @@unique([id, organizationId])
  @@index([organizationId, propertyId, createdAt])
  @@index([abuseKey, createdAt])
  @@index([leadId])
}

model JourneyEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  visitId String @db.Uuid
  visit TourVisit @relation(fields: [visitId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sequence Int
  kind String @db.VarChar(30)
  sceneId String? @db.Uuid
  durationMs Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([visitId, sequence])
  @@index([organizationId, createdAt])
}

model VisitRequest {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  preferredDate String @db.VarChar(10)
  period String @db.VarChar(15)
  status String @default("REQUESTED") @db.VarChar(15)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@unique([leadId, preferredDate, period])
  @@index([organizationId, status, preferredDate])
}

model PropertyPhoto {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId String @db.Uuid
  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey String @unique
  uploadKey String @unique
  fileName String @db.VarChar(160)
  size Int
  status AssetStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([organizationId, propertyId, status])
}

enum TourStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Tour {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  propertyId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title String @db.VarChar(120)
  status TourStatus @default(DRAFT)
  version Int @default(1)
  draft Json @default("{\"scenes\":[],\"initialSceneId\":null}")
  published Json?
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assets PanoramaAsset[]
  @@unique([id, organizationId])
  @@index([organizationId, propertyId, createdAt])
}

enum AssetStatus {
  PENDING
  READY
  FAILED
}

model PanoramaAsset {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  tourId String @db.Uuid
  tour Tour @relation(fields: [tourId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey String @unique
  uploadKey String @unique
  fileName String @db.VarChar(160)
  mimeType String
  size Int
  width Int?
  height Int?
  status AssetStatus @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([organizationId, tourId, status])
}
