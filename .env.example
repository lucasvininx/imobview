DATABASE_URL=postgresql://imobview_app:local-development-only@127.0.0.1:55432/imobview
DIRECT_DATABASE_URL=postgresql://imobview:local-development-only@127.0.0.1:55432/imobview
TEST_DATABASE_URL=postgresql://imobview_app:local-development-only@127.0.0.1:55432/imobview_test
TEST_DIRECT_DATABASE_URL=postgresql://imobview:local-development-only@127.0.0.1:55432/imobview_test
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required to seed local demo accounts; never seed production.
SEED_PASSWORD=
# SMTP is required in production. Locally use Mailpit on port 1025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=ImobView <nao-responda@imobview.test>
# SMTP_USER=
# SMTP_PASSWORD=

# Supabase Storage: private bucket; secret key is SERVER ONLY.
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=
SUPABASE_TOUR_BUCKET=imobview-tours
# Use Supabase PostgreSQL with a restricted imobview_app role for DATABASE_URL.
# DIRECT_DATABASE_URL is the migration role; never use it as the runtime role.

# Commercial identity. Do not publish invented contact information.
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTRATION=
BUSINESS_EMAIL=
# Digits only: 55 + DDD + number.
BUSINESS_WHATSAPP=
DEMO_PROPERTY_SLUG=casa-modelo-tour-360
LEGAL_REVIEWED=false
# Operations: configure in the operator environment, not in the browser.
# BACKUP_ENCRYPTION_KEY=64-hex-characters-generated-randomly
BACKUP_DIRECTORY=.local/backups
# RESTORE_TEST_DATABASE_URL=postgresql://admin:password@127.0.0.1:55432/imobview_unique_restore_test
# OPERATIONS_MONITOR_URL=https://your-domain.example
# OPERATIONS_ALERT_WEBHOOK_URL=https://your-alert-receiver.example/events
